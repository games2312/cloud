# =============================================================================
# Sports Predictor — Variables d'environnement
# =============================================================================
# Copiez ce fichier en .env et renseignez vos clés API.
#
# cp .env.example .env

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sports_predictor
DB_USER=predictor
DB_PASSWORD=changeme

# API Sportmonks (https://www.sportmonks.com)
SPORTMONKS_TOKEN=

# The Odds API (https://the-odds-api.com)
ODDS_API_KEY=

# API-Sports (https://api-sports.io)
API_SPORTS_KEY=

# CapMonster Cloud pour résolution CAPTCHA
CAPMONSTER_KEY=

# Clés proxy (format: http://user:pass@host:port, séparées par des virgules)
PROXY_LIST=

# Environnement
ENVIRONMENT=development
LOG_LEVEL=INFO